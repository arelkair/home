---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  widths?: number[];
  sizes?: string;
}

const { project, widths = [240, 480], sizes = "240px" } = Astro.props;
---

<span class:list={["project-media", { icon: !project.cover }]}>
  {
    project.cover ? (
      <Image src={project.cover.src} alt="" widths={widths} sizes={sizes} loading="lazy" />
    ) : (
      project.icon && <Image src={project.icon} alt="" widths={[96, 192]} sizes="96px" loading="lazy" />
    )
  }
</span>
