---
import "../styles/global.css";
import "allo-font/allo-friendly.css";
import alloLatin from "allo-font/fonts/webfonts/AlloVariableFriendly.woff2?url";

interface Props {
  path: string;
  title?: string;
  description?: string;
}

const { path, title, description } = Astro.props;
const site = Astro.site!.origin;
const pageTitle = title ? `${title}, Arel Kair` : "Arel Kair";
const pageDescription = description ?? "Arel Kair works on computers and reverse engineering: a static recompilation of Wii Party for PC, plus Nivra and Pool.";
const canonical = site + (path || "/");
const isHome = path === "";

const elsewhere: [string, string][] = [
  ["GitHub", "https://github.com/arelkair"],
  ["X", "https://x.com/arelkair"],
  ["YouTube", "https://www.youtube.com/@arelkair"],
  ["TikTok", "https://www.tiktok.com/@arelkair"],
];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Arel Kair",
  alternateName: "Mateo Fresco Canicoba",
  url: `${site}/`,
  sameAs: elsewhere.map(([, url]) => url),
  address: { "@type": "PostalAddress", addressCountry: "ES" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arel Kair" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={alloLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body class="mx-auto max-w-[calc(45rem+48px)] bg-paper px-6 pt-[clamp(64px,14vh,128px)] pb-16 font-sans text-[1.0625rem] leading-[1.6] font-[420] text-ink antialiased max-sm:pt-12 max-sm:text-base">
    <header class="mb-12 max-sm:mb-8">
      <h1 class="text-2xl leading-[1.3] font-bold"><a href="/">Arel Kair</a></h1>
      <p class="mt-1 text-xl leading-[1.4] motion-safe:animate-rise">Computers <span class="text-muted">&amp;</span> Reverse Engineering</p>
    </header>
    <main id="main" class="motion-safe:animate-rise motion-safe:[animation-delay:120ms]">
      <slot />
    </main>
    <footer class="mt-24 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-ink/12 pt-6 text-[0.9375rem] text-muted">
      <p>Arel Kair, also known as Mateo Fresco Canicoba.</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-1" aria-label="Elsewhere">
        {elsewhere.map(([label, url]) => <a class="py-1.5 transition-colors hover:text-ink" href={url} rel="me">{label}</a>)}
      </nav>
    </footer>
  </body>
</html>
