---
import "@fontsource-variable/lora/wght.css";
import "@fontsource-variable/lora/wght-italic.css";
import "../styles/global.css";
import { t } from "../i18n";

interface Props {
  path: string;
  title?: string;
  description?: string;
}

const { path, title, description } = Astro.props;
const site = Astro.site!.origin;
const pageTitle = title ? `${title}, Arel Kair` : "Arel Kair";
const pageDescription = description ?? t("metaDescription");
const canonical = site + (path || "/");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Arel Kair",
  url: `${site}/`,
  sameAs: ["https://github.com/arelkair", "https://x.com/arelkair", "https://www.youtube.com/@arelkair", "https://www.tiktok.com/@arelkair"],
  address: { "@type": "PostalAddress", addressCountry: "ES" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arel Kair" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    {path === "" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <header class="masthead">
      <div>
        <a class="name" href="/">Arel Kair</a>
        <p class="tagline">Computers <span>&amp;</span> Reverse Engineering</p>
      </div>
      <nav aria-label="Blog">
        <a href="/blog" aria-current={path.startsWith("/blog") ? "page" : undefined}>Blog</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
