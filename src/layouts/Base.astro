---
import "../styles/global.css";
import "allo-font/allo-friendly.css";
import { t } from "../i18n";
import alloLatin from "allo-font/fonts/webfonts/AlloVariableFriendly.woff2?url";

interface Props {
  path: string;
  title?: string;
  description?: string;
}

const { path, title, description } = Astro.props;
const site = Astro.site!.origin;
const pageTitle = title ? `${title}, Arel Kair` : "Arel Kair";
const pageDescription = description ?? t("metaDescription");
const canonical = site + (path || "/");
const isHome = path === "";
const siteHeading = isHome || path === "/work" || path === "/404";

const elsewhere: [string, string][] = [
  ["GitHub", "https://github.com/arelkair"],
  ["X", "https://x.com/arelkair"],
  ["YouTube", "https://www.youtube.com/@arelkair"],
  ["TikTok", "https://www.tiktok.com/@arelkair"],
];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Arel Kair",
  alternateName: "Mateo Fresco Canicoba",
  url: `${site}/`,
  sameAs: elsewhere.map(([, url]) => url),
  address: { "@type": "PostalAddress", addressCountry: "ES" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arel Kair" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={alloLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <header class="masthead">
      <div>
        {
          siteHeading ? (
            <h1 class="site-name">
              <a class="name" href="/">Arel Kair</a>
            </h1>
          ) : (
            <p class="site-name">
              <a class="name" href="/">Arel Kair</a>
            </p>
          )
        }
        <p class="tagline">Computers <span>&amp;</span> Reverse Engineering</p>
      </div>
      <nav aria-label="Sections">
        <a href="/work" aria-current={path.startsWith("/work") ? "page" : undefined}>Work</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>{t("footNote")}</p>
      <nav aria-label={t("elsewhere")}>
        {elsewhere.map(([label, url]) => <a href={url} rel="me">{label}</a>)}
      </nav>
    </footer>
  </body>
</html>
