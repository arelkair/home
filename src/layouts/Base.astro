---
import "@fontsource-variable/lora/wght.css";
import "@fontsource-variable/lora/wght-italic.css";
import "../styles/global.css";
import { locales, localeNames, localize, translator, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  path: string;
  title?: string;
  description?: string;
}

const { lang, path, title, description } = Astro.props;
const t = translator(lang);
const site = Astro.site!.origin;
const pageTitle = title ? `${title}, Arel Kair` : "Arel Kair";
const pageDescription = description ?? t("metaDescription");
const canonical = site + localize(lang, path);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Arel Kair",
  url: `${site}/`,
  sameAs: ["https://github.com/arelkair", "https://x.com/arelkair", "https://www.youtube.com/@arelkair", "https://www.tiktok.com/@arelkair"],
  address: { "@type": "PostalAddress", addressCountry: "ES" },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={site + localize(code, path)} />)}
    <link rel="alternate" hreflang="x-default" href={site + localize("en", path)} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arel Kair" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {path === "" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <header class="masthead">
      <div>
        <a class="name" href={localize(lang)}>Arel Kair</a>
        <p class="tagline">Computers <span>&amp;</span> Reverse Engineering</p>
      </div>
      <nav aria-label="Blog">
        <a href={localize(lang, "/blog")} aria-current={path === "/blog" ? "page" : undefined}>Blog</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <nav aria-label={t("langLabel")}>
        {
          locales.map((code) => (
            <a href={localize(code, path)} hreflang={code} lang={code} aria-current={code === lang ? "true" : undefined} title={localeNames[code]}>
              {code}
            </a>
          ))
        }
      </nav>
      <p>&copy; 2026</p>
    </footer>
  </body>
</html>
