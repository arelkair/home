---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import { localePaths, localize, translator, type Locale } from "../../../i18n";
import { overallProgress, projects, type Project } from "../../../data/projects";

export function getStaticPaths() {
  return localePaths().flatMap(({ params, props }) =>
    projects.map((project, i) => ({
      params: { ...params, slug: project.slug },
      props: { ...props, project, next: projects[(i + 1) % projects.length] },
    })),
  );
}

const { lang, project, next } = Astro.props as { lang: Locale; project: Project; next: Project };
const t = translator(lang);
const facts: [string, string][] = [
  ["factStatus", project.status],
  ["factSince", project.since],
  ["factStack", project.stack.join(", ")],
  ...project.facts,
];
---

<Base lang={lang} path={`/work/${project.slug}`} title={project.name} description={t(project.lead)}>
  <header>
    <a class="back" href={localize(lang)}>Arel Kair</a>
    <h1>{project.name}</h1>
    <p>{t(project.lead)}</p>
    <p class="inline">
      {
        project.links.map(([label, url]) => (
          <a href={url} target="_blank" rel="noopener">
            {t(label)}
          </a>
        ))
      }
    </p>
  </header>

  <dl>
    {
      facts.map(([term, value]) => (
        <div>
          <dt>{t(term)}</dt>
          <dd>{t(value)}</dd>
        </div>
      ))
    }
  </dl>

  {
    project.cover && (
      <figure>
        <Image src={project.cover.src} alt={t(project.cover.alt)} widths={[640, 1280]} sizes="(min-width: 640px) 576px, 100vw" loading="eager" />
      </figure>
    )
  }

  {
    project.progress && (
      <section aria-labelledby="progress">
        <h2 id="progress">
          {t("wiiProgress")}, {overallProgress}%
        </h2>
        <dl>
          {project.progress.map(([name, value]) => (
            <div>
              <dt>{t(name)}</dt>
              <dd>{value}%</dd>
            </div>
          ))}
        </dl>
        <p class="note">{t("wiiEstimate")}</p>
      </section>
    )
  }

  {
    project.sections.map((section) => (
      <section>
        <h2>{t(section.title)}</h2>
        {section.blocks.map((block) =>
          "p" in block ? (
            <p>{t(block.p)}</p>
          ) : "files" in block ? (
            <dl>
              {block.files.map(([path, desc]) => (
                <div>
                  <dt>
                    <code>{path}</code>
                  </dt>
                  <dd>{t(desc)}</dd>
                </div>
              ))}
            </dl>
          ) : "groups" in block ? (
            <dl>
              {block.groups.map(([term, list]) => (
                <div>
                  <dt>{t(term)}</dt>
                  <dd>{t(list)}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <figure class:list={{ portrait: block.portrait }}>
              <Image src={block.figure} alt={t(block.alt)} widths={[400, 800, 1200]} sizes="(min-width: 640px) 576px, 100vw" loading="lazy" />
            </figure>
          ),
        )}
      </section>
    ))
  }

  <nav class="next" aria-label={t("nextProject")}>
    {t("nextProject")}: <a href={localize(lang, `/work/${next.slug}`)}>{next.name}</a>
  </nav>
</Base>
