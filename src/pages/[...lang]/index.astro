---
import Base from "../../layouts/Base.astro";
import { localePaths, localize, translator, type Locale } from "../../i18n";
import { projects, socials } from "../../data/projects";

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);
---

<Base lang={lang} path="">
  <header>
    <h1>Arel Kair</h1>
    <p>{t("heroIntro")}</p>
  </header>

  <section aria-labelledby="work">
    <h2 id="work">{t("workTitle")}</h2>
    <ul class="list">
      {
        projects.map((project) => (
          <li>
            <a href={localize(lang, `/work/${project.slug}`)}>{project.name}</a>
            <p>{t(project.summary)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="about">
    <h2 id="about">{t("aboutTitle")}</h2>
    <p>{t("about2")}</p>
    <p>{t("about4")}</p>
  </section>

  <section aria-labelledby="social">
    <h2 id="social">{t("socialTitle")}</h2>
    <p class="inline">
      {
        socials.map(([name, url]) => (
          <a href={url} target="_blank" rel="noopener me">
            {name}
          </a>
        ))
      }
    </p>
  </section>
</Base>
