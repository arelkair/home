---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";
---

<Base path="">
  <p class="mb-10 max-w-160 motion-safe:animate-rise">
    I like finding out how programs work by taking them apart, and I build games and tools along the way. These are the biggest things I have made so far.
  </p>
  <ul class="-mx-4 grid gap-1 max-sm:-mx-3">
    {
      projects.map((project, i) => (
        <li class="motion-safe:animate-rise" style={`animation-delay:${150 + i * 130}ms`}>
          <a
            class="group relative isolate grid transition-transform duration-300 active:scale-[0.995] grid-cols-[15rem_minmax(0,1fr)] gap-x-6 gap-y-0.5 px-4 py-3.5 before:absolute before:inset-0 before:-z-10 before:-translate-x-3 before:bg-ink/5 before:opacity-0 before:transition-[opacity,translate] before:duration-500 before:ease-[cubic-bezier(0.23,1,0.32,1)] hover:before:translate-x-0 hover:before:opacity-100 focus-visible:before:translate-x-0 focus-visible:before:opacity-100 max-sm:grid-cols-1 max-sm:p-3"
            href={project.href}
            target="_blank"
            rel="noopener"
          >
            <span class="leading-[1.4] font-semibold transition-transform duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-x-1.5 group-focus-visible:translate-x-1.5">
              {project.name}
              <span class="ml-1.5 inline-block -translate-x-1 translate-y-0.5 text-[0.875rem] font-normal text-muted opacity-0 transition-[opacity,translate] duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-x-0 group-hover:translate-y-0 group-hover:text-ink group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 pointer-coarse:translate-x-0 pointer-coarse:translate-y-0 pointer-coarse:opacity-100" aria-hidden="true"><svg class="size-2.5 translate-y-px" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M2 8 8 2M3.5 2H8v4.5" /></svg></span>
            </span>
            <span class="grid">
              <span>{project.summary}</span>
              <span class="text-[0.9375rem] text-muted tabular-nums transition-colors duration-500 group-hover:text-ink group-focus-visible:text-ink">
                {project.status} since {project.since}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
