---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";
---

<Base path="">
  <p class="mb-10 max-w-160">
    I like finding out how programs work by taking them apart, and I build games and tools along the way. These are the biggest things I have made so far.
  </p>
  <ul class="-mx-4 grid gap-1 max-sm:-mx-3">
    {
      projects.map((project) => (
        <li>
          <a
            class="group grid grid-cols-[15rem_minmax(0,1fr)] gap-x-6 gap-y-0.5 rounded-[10px] px-4 py-3.5 transition-[background-color,transform] duration-75 active:scale-[0.99] hover:bg-ink/6 max-sm:grid-cols-1 max-sm:p-3"
            href={project.href}
            target="_blank"
            rel="noopener"
          >
            <span class="leading-[1.4] font-semibold">
              {project.name}
              <span class="ml-1.5 inline-block text-[0.875rem] font-normal text-muted transition-[transform,color] duration-75 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink" aria-hidden="true">↗</span>
            </span>
            <span class="grid">
              <span>{project.summary}</span>
              <span class="text-[0.9375rem] text-muted">
                {project.status} since {project.since}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
