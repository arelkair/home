---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";
import snorlax from "../assets/snorlax.webp";
---

<Base path="">
  <p class="intro">
    I take software apart to see how it works, then rebuild it to run somewhere new. Right now that means translating a Wii game into native C++ for PC. Before that, I made two multiplayer browser games and a private organizer.
  </p>
  <ul class="rows">
    {
      projects.map((project) => (
        <li>
          <a class="row" href={project.repo} target="_blank" rel="noopener">
            <span class="row-title">
              {project.name}
              <span class="arrow" aria-hidden="true">↗</span>
            </span>
            <span class="row-text">
              <span>{project.short}</span>
              <span class="row-detail">{project.detail}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <Image class="mascot" src={snorlax} alt="" widths={[280, 560]} sizes="280px" loading="lazy" />
</Base>
