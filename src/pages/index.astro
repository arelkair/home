---
import Base from "../layouts/Base.astro";
import { t } from "../i18n";
import { projects } from "../data/projects";
---

<Base path="">
  <p class="intro">
    I like finding out how programs work by taking them apart, and I build games and tools along the way. These are the biggest things I have made so far.
  </p>
  <ul class="rows">
    {
      projects.map((project) => (
        <li>
          <a class="row" href={`/work/${project.slug}`}>
            <span class="row-title">{project.name}</span>
            <span class="row-text">
              <span>{t(project.summary)}</span>
              <span class="row-detail">
                {t(project.status)} since {t(project.since)}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
