---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import { t } from "../../i18n";
import { projects } from "../../data/projects";
---

<Base path="/work" title="Work" description="Projects by Arel Kair: a Wii Party recompilation for PC, Nivra and Pool.">
  <a class="back" href="/"><span aria-hidden="true">←</span> Back</a>
  <ul class="rows">
    {
      projects.map((project) => (
        <li>
          <a class="row project" href={`/work/${project.slug}`}>
            <ProjectMedia project={project} />
            <span class="project-body">
              <span class="project-name">{project.name}</span>
              <span>{t(project.summary)}</span>
              <span class="row-detail">
                {t(project.status)} since {t(project.since)}
              </span>
              <span class="row-detail">{project.stack.join(", ")}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
