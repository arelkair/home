---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";
import { projects } from "../../data/projects";
---

<Base path="/work" title="Work" description="Projects by Arel Kair: a Wii Party recompilation for PC, Nivra, Pool and Poisoned Candy.">
  <a class="back" href="/"><span aria-hidden="true">←</span> Back</a>
  <ul class="rows">
    {
      projects.map((project) => (
        <li>
          <a class="row project" href={`/work/${project.slug}`}>
            <span class:list={["project-media", { icon: !project.cover }]}>
              {project.cover ? (
                <Image src={project.cover.src} alt="" widths={[240, 480]} sizes="240px" loading="lazy" />
              ) : (
                project.icon && <Image src={project.icon} alt="" widths={[96, 192]} sizes="96px" loading="lazy" />
              )}
            </span>
            <span class="project-body">
              <span class="project-name">{project.name}</span>
              <span>{t(project.summary)}</span>
              <span class="row-detail">
                {t(project.status)} since {t(project.since)}
              </span>
              <span class="row-detail">{project.stack.join(", ")}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
